# ============================================================================
# DEEPSEEK AI CONFIGURATION
# ============================================================================
# API Key para la integración con Deepseek AI
# Obtén tu clave desde: https://platform.deepseek.com/account/api_keys
# Requerido para: Asistente académico, análisis de documentos
DEEPSEEK_API_KEY=sk_your_api_key_here_replace_with_real_key

# Modelo de Deepseek a utilizar (por defecto: deepseek-chat)
# Opciones: deepseek-chat, deepseek-coder
DEEPSEEK_MODEL=deepseek-chat

# Temperatura para respuestas del AI (0.0 a 2.0)
# 0.0 = respuestas determinísticas
# 1.0 = balance
# 2.0 = máxima creatividad
DEEPSEEK_TEMPERATURE=0.7

# Tokens máximos por respuesta
DEEPSEEK_MAX_TOKENS=2000
